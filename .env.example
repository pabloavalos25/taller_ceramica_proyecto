# Configurar con una URL privada para una base PostgreSQL dedicada; nunca usar datos reales en pruebas.
DATABASE_URL=
TEST_DATABASE_URL=
# Origen público exacto, sin barra final. HTTPS es obligatorio en producción.
APP_ORIGIN=
# No habilitar hasta completar la integración y revisión de seguridad.
AUTH_WEB_ENABLED=false
# El proceso de cuotas está deshabilitado por defecto; habilitar solo en entorno configurado y revisado.
FEE_WORKER_ENABLED=false
# Primer período a comprobar, formato AAAA-MM; debe tener configuración histórica de valor y vencimiento.
FEE_GENERATION_START=
FEE_WORKER_INTERVAL_SECONDS=3600
